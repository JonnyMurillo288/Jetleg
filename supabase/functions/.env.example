# Secrets for the edge functions, local stack. Copy to `.env` (gitignored)
# next to this file; `supabase start` loads it. Restart the stack after
# changing it: `npx supabase stop && npx supabase start`.
#
# On a cloud project the same names are set with `npx supabase secrets set`.

# The fixed testing sign-in code (see migrations/0010_test_logins.sql).
# Leave unset to keep the feature off. Six digits, to fit the app's code box.
# It only works for addresses added with `npx tsx test-login.ts <email>`.
TEST_LOGIN_CODE=

# Stripe — what each is and where to get it: PAYMENTS_TESTING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE_GAME=
STRIPE_PRICE_WEEK_PASS=
APP_URL=
