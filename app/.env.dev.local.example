# The online dev copy's backend. Copy to `.env.dev.local` (gitignored via
# *.local) and fill in from the dev Supabase project: Project Settings > API.
#
# `npm run build:dev` / `npm run deploy:dev` use this file; plain
# `npm run build` keeps using `.env.local` (the local Docker stack).
# Both values are public — they ship in the app — but the service-role key
# is not, and never belongs here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
