# Copy to .env.local (gitignored via *.local) and fill in.
# Local Docker Supabase: run `supabase start` from the repo root and use
# the "API URL" / "anon key" it prints.
# Cloud project: from the Supabase dashboard, Project Settings > API.
#
# Leaving these unset is fine — the app runs local-only with no sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where "Report a bug" (the ? tab) addresses its email. The address ships in
# the built app, so use one you are happy for players to see.
VITE_REPORT_EMAIL=
